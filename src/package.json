{
  "name": "ducatone",
  "productName": "DucatONE",
  "version": "3.1.0",
  "description": "DucatONE - Manuale officina Fiat Ducato",
  "main": "main.js",
  "author": {
    "name": "eLearn",
    "email": "tecnologo83@gmail.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "mdb-reader": "^3.2.0",
    "saxon-js": "^2.7.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.0.12"
  },
  "homepage": "https://github.com/Projekto1983/DucatONE",
  "build": {
    "appId": "it.ducatone.app",
    "productName": "DucatONE",
